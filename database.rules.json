{
  "rules": {
    ".read": false,
    ".write": false,
    "matches": {
      "$matchId": {
        ".read": "auth != null && data.child('participants').child(auth.uid).val() === true",
        ".write": "auth != null && data.child('participants').child(auth.uid).val() === true && !newData.exists()"
      }
    }
  }
}
